# 不得在這個檔案寫 WiFi 密碼或裝置代碼；那些值用 idf.py menuconfig 設定，存在 sdkconfig（不進 git）。
CONFIG_IDF_TARGET="esp32p4"

# 1 ms tick，馬達時序與逾時才準
CONFIG_FREERTOS_HZ=1000

# 板子：16 MB Flash（商品頁）、32 MB PSRAM（晶片內建）
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y

# 自訂分割表：app 6 MB（加入 LVGL 後超過內建分割表的 1.5 MB）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# WiFi 協處理器：板上 ESP32-C6，走 SDIO（esp_hosted 文件 esp32_p4_function_ev_board.md）
# 2026-11-22 開機 log：Identified slave [esp32c6]、Reset slave using GPIO[54]，和 Function EV 板預設相同
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y

# 晶片版本：這批板子是 ESP32-P4 v1.3（2026-11-22 開機 log）。
# ESP-IDF v5.5.6 預設只支援 v3.x，兩者硬體不相容；不設這行 esptool 會拒絕燒錄。
# 之後買到 v3.x 晶片的板子時必須拿掉這行，不得用 --force。
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y

# 畫面字型：狀態列用內建英數字型；中文字型由 tools/gen_ui_font.py 產生（components/ui/fonts）
CONFIG_LV_FONT_MONTSERRAT_20=y

# USB 集線器：掃碼器、鍵盤、讀卡機經集線器接到高速 Type-C 孔（板子沒有 USB-A）。
# 不開時集線器後面的裝置完全沒有反應。
CONFIG_USB_HOST_HUBS_SUPPORTED=y

# OTA 退回機制：新版開機後沒有被程式確認（ota_confirm_running）就重開機時，bootloader 退回上一版
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# 板上鏡頭 OV02C10（MIPI-CSI，1 lane，RAW10 1288x728，和出廠程式相同）＋ ISP
CONFIG_CAMERA_OV02C10=y
CONFIG_CAMERA_OV02C10_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV02C10_MIPI_RAW10_1288X728_30FPS=y
CONFIG_CAMERA_OV02C10_MIPI_DEFAULT_FMT_RAW10_1288X728_30FPS=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y
